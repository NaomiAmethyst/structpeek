{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "format": "uuid"
      },
      "placed": {
        "type": "string",
        "format": "date-time"
      },
      "status": {
        "$ref": "#/$defs/lowCardinalityString"
      },
      "currency": {
        "$ref": "#/$defs/lowCardinalityString"
      },
      "customer": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "object",
            "properties": {
              "city": {
                "$ref": "#/$defs/lowCardinalityString"
              },
              "postcode": {
                "type": "string"
              }
            },
            "required": [
              "city",
              "postcode"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "email",
          "name",
          "address"
        ],
        "additionalProperties": false
      },
      "lines": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "sku": {
              "type": "string"
            },
            "qty": {
              "type": "integer"
            },
            "price": {
              "type": "number"
            }
          },
          "required": [
            "sku",
            "qty",
            "price"
          ],
          "additionalProperties": false
        }
      },
      "payment": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/lowCardinalityString"
              },
              "last4": {
                "type": "string"
              },
              "auth_code": {
                "$ref": "#/$defs/highEntropyString"
              }
            },
            "required": [
              "method",
              "last4",
              "auth_code"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "method": {
                "$ref": "#/$defs/lowCardinalityString"
              },
              "due_days": {
                "type": "integer"
              }
            },
            "required": [
              "method",
              "due_days"
            ],
            "additionalProperties": false
          }
        ]
      },
      "gift": {
        "type": "boolean"
      },
      "notes": {
        "type": [
          "string",
          "null"
        ]
      }
    },
    "required": [
      "id",
      "placed",
      "status",
      "currency",
      "customer",
      "lines",
      "payment",
      "gift",
      "notes"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "lowCardinalityString": {
      "description": "A string drawn from a small set of values that repeat. The values are withheld, as they could be sensitive.",
      "type": "string"
    },
    "highEntropyString": {
      "description": "A string that looks randomly generated, such as a key, token, hash or opaque ID. The values are withheld.",
      "type": "string"
    }
  }
}
