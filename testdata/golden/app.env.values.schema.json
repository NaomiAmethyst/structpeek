{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "DATABASE_URL": {
      "type": "string",
      "format": "uri"
    },
    "REDIS_URL": {
      "type": "string",
      "format": "uri"
    },
    "STORAGE_ACCESS_KEY_ID": {
      "$ref": "#/$defs/highEntropyString"
    },
    "STORAGE_SECRET_ACCESS_KEY": {
      "$ref": "#/$defs/highEntropyString"
    },
    "PORT": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "DEBUG": {
      "type": "boolean"
    },
    "LOG_LEVEL": {
      "type": "string"
    },
    "WELCOME_MESSAGE": {
      "type": "string"
    }
  },
  "required": [
    "DATABASE_URL",
    "REDIS_URL",
    "STORAGE_ACCESS_KEY_ID",
    "STORAGE_SECRET_ACCESS_KEY",
    "PORT",
    "DEBUG",
    "LOG_LEVEL",
    "WELCOME_MESSAGE"
  ],
  "additionalProperties": false,
  "$defs": {
    "highEntropyString": {
      "description": "A string that looks randomly generated, such as a key, token, hash or opaque ID. The values are withheld.",
      "type": "string"
    }
  }
}
