{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "integer"
      },
      "name": {
        "type": "string"
      },
      "team": {
        "$ref": "#/$defs/lowCardinalityString"
      },
      "joined": {
        "type": "string",
        "format": "date"
      },
      "manager": {
        "type": [
          "integer",
          "null"
        ]
      },
      "salary": {
        "type": "integer"
      },
      "remote": {
        "type": "boolean"
      }
    },
    "required": [
      "id",
      "name",
      "team",
      "joined",
      "manager",
      "salary",
      "remote"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "lowCardinalityString": {
      "description": "A string drawn from a small set of values that repeat. The values are withheld, as they could be sensitive.",
      "type": "string"
    }
  }
}
